<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Napit avaavat nämä sovellukset. Android 11+ ei näytä muita paketteja ilman tätä,
         jolloin getLaunchIntentForPackage palauttaisi nullin. -->
    <queries>
        <package android:name="com.aspiro.wamp" />
        <package android:name="com.cylonid.nativealpha" />
        <package android:name="fi.tusinasaa.soitin" />
        <package android:name="de.markusfisch.android.binaryeye" />
        <package android:name="fi.tusinasaa" />
    </queries>

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:label="Odotushuone"
        android:supportsRtl="true"
        android:theme="@style/Theme.Odotushuone">
        <activity
            android:name="fi.tusinasaa.odotushuone.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
