<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Soitto jatkuu, kun näyttö sammuu tai käyttäjä siirtyy toiseen sovellukseen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Ilmoituslupaa ei kysytä: Android 13+ piilottaa silloin soittoilmoituksen, mutta
      etualapalvelu toimii silti. Ilmoituksen saa näkyviin myöntämällä luvan adb:llä.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Ei noHistory-asetusta kuten Tusinasäässä: se sulkisi aktiviteetin ja katkaisisi
      soiton heti, kun käyttäjä siirtyy toiseen sovellukseen. configChanges kattaa myös
      teeman (uiMode), ettei aktiviteetti käynnisty uudelleen kesken soiton.
    -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Soitin">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
