<resources>
    <!--
      Tumma AppCompat-teema: WebView välittää sivulle prefers-color-scheme: dark, joten
      soitin/index.html näyttää oman tumman teemansa. Musta tausta estää valkoisen
      välähdyksen ennen kuin sivu on latautunut.
    -->
    <style name="Theme.Soitin" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
