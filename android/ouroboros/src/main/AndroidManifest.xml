<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Napit avaavat nämä sovellukset. Android 11+ ei näytä muita paketteja ilman tätä,
         jolloin getLaunchIntentForPackage palauttaisi nullin. -->
    <queries>
        <package android:name="com.aspiro.wamp" />
        <package android:name="com.cylonid.nativealpha" />
        <package android:name="fi.tusinasaa.soitin" />
        <package android:name="de.markusfisch.android.binaryeye" />
        <package android:name="fi.tusinasaa" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="ΒΟΡΟΦΘΟΡΟΣ"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
        <activity
            android:name="fi.ouroboros.android.MainActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
